<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
    <section name="bankSettings" type="SFTPOut_Listener.BankSection, SFTPOut_Listener" />
  </configSections>

  <log4net>
    <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <file value="D:\CTSLite\Logs\SFTPOut\SFTPOut.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value="'_'yyyyMMdd" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <staticLogFileName value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %level %logger - %message%newline%exception" />
      </layout>
    </appender>
    <root>
      <level value="INFO" />
      <appender-ref ref="RollingFileAppender" />
    </root>
  </log4net>

  <appSettings>
    <add key="SLEEP_MS" value="3000" />
    <add key="TRANSFER_TIMEOUT_MS" value="600000" />
    <!-- DB -->
    <add key="DB_CONN_STRING" value="Data Source=YAN;Initial Catalog=CTSLiteDB;Integrated Security=SSPI;Connection Timeout=5;" />

    <add key="STATUS_READY" value="P_Encrypt_Success" />
    <add key="STATUS_PROCESSING" value="S_Send_Processing" />
    <add key="STATUS_SUCCESS" value="S_Send_Success" />
    <add key="STATUS_FAILED" value="S_Send_Failed" />


    <add key="SOURCE_ROOT" value="D:\CTSLite\Outward" />
    <add key="SENT_SUBFOLDER" value="Sent" />
  </appSettings>


  <bankSettings>

    <add issBk="7339"
         name="LocalTest"
         transferMode="TECTIA"
         program="scpg3"
         host="localhost"
         port="22"
         user="sftptest"
         pass=""
         remoteDir="Outward"
         cmd="-P {port} -p -q &quot;{local}&quot; {user}@{host}:{remoteFile}" />

    <!-- <add issBk="XXXX" name="OtherBank" transferMode="CONNECTDIRECT"
       program="(Connect:Direct command-line program ရဲ့ path)"
       host="" port="" user="" pass="" remoteDir="/Outward"
       cmd=" "
       scriptTemplate="D:\CTSLite\Config\bankX_send.tpl"
       okExitCodes="0" /> -->
  </bankSettings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>